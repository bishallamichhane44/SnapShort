# App
APP_ENV=development
SECRET_KEY=your-256-bit-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# PostgreSQL (Neon in prod: use ?sslmode=require)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/snapshort?sslmode=require

# DynamoDB
AWS_REGION=us-east-1
DYNAMODB_TABLE_NAME=snapshort-links
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret

# Local dev with DynamoDB Local (empty in production)
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# Short code config
SHORT_CODE_LENGTH=7
BASE_URL=http://localhost:8000

# Optional: link TTL in days (0 = no expiry)
DEFAULT_LINK_TTL_DAYS=0
